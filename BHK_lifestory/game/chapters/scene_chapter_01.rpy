label scene_chapter_01:
    # ---------------------------------------------------------
    # 0. 2002년 춘천 병실로 회귀
    # ---------------------------------------------------------
    scene bg hospital with fade

    sys "2002년 9월 13일 가평 모 병원 병실"

    $ renpy.pause(1.0)

    sys "부모님이 땀 흘려 일궈낸 작은 자영업의 터전 위에서,\n나는 지극히 평범하고 무탈하게 첫 울음을 터뜨렸다."
    sys "남부럽지 않았다. 어릴 적의 나는 먹고 싶은 건 먹었고, 떼쓰는 족족 손에 쥘 수 있었다."
    sys "적어도 그때까지는 몰랐다.\n내 인생이 낭떠러지 위를 걷는 곡예가 될 줄은."

    $ renpy.pause(1.0)

    # ==============================================================================
    # 1. 삼육초등학교 시절: 조용한 결핍과 엘리트 의식
    # ==============================================================================
    scene bg elementary_school with fade

    sys "춘천 삼육초등학교."
    sys "도내 유일의 사립 명문초라는 간판 아래,\n등굣길 교문 앞은 매일 아침 외제차와 정장 입은 학부모들로 붐볐다."
    sys "의사, 대학교수, 지역 유지들의 자제들 틈바구니에서\n자영업을 하시는 부모님의 헌신 덕에 나 역시 그들과 어깨를 나란히 할 수 있었다."

    sys "은연중에 스며든 계급적 결핍을 감추기 위해\n내가 온몸에 둘렀던 방어기제는 다름 아닌 '알량한 선민의식'이었다."
    sys "그 엘리트 집단 속에서 자라며, 나는 당연히 내가 걸어갈 다음 길도\n남들과 다른 '특별한 사립의 길'일 것이라 한 치의 의심도 품지 않았다."

    # ==============================================================================
    # 2. 가세의 기울어짐과 가출 투쟁: 일반중이라는 현실
    # ==============================================================================
    scene bg dark_house with fade
    play music "audio/bgm_dark.ogg" fadein 1.0
    $ renpy.pause(1.0)

    sys "하지만 열세 살의 철부지가 미처 내다보지 못한 변수가 있었다."
    sys "하필 그 무렵, 아버지의 사업 실적이 곤두박질치기 시작한 것이다."

    sys "통장 잔고와 가게 월세 걱정으로 밤마다 한숨을 내쉬던 부모님의 공기 따위,\n눈에 뵈는 게 없던 사춘기 어린놈의 안중에는 없었다."

    sys "'사립중 진학 포기',\n그리고 날아든 '일반 공립 중학교 배정 통지서'."

    me "싫어! 내가 왜 그런 데를 가야 하는데? 애들이 날 어떻게 보겠어!"

    sys "남들과 똑같은 일반 중학교에 간다는 건,\n내가 쌓아 올린 모든 자존심과 우월감이 길바닥에 짓밟히는 것과 같았다."
    sys "그 현실을 받아들이지 못한 나는 집을 뛰쳐나갔다."
    
    
    scene bg street_night with fade

    sys "가출이었다."
    sys "추운 밤거리를 정처 없이 배회하며 온몸으로 반항하고 버텼지만,\n현실의 거대한 파도는 쥐뿔도 없는 중학생의 떼쟁이 투쟁 따위로 거스를 수 있는 게 아니었다."

    sys "결국 며칠 만에 꼬리를 내리고 집으로 돌아왔고,\n차가운 패배감과 부모님을 향한 비뚤어진 원망을 가슴에 품은 채——"

    stop music fadeout 1.0


    # ==============================================================================
    # 3. 일반 중학교 진학: 오만과 고립, 그리고 천호
    # ==============================================================================
    scene bg middle_school_classroom with fade

    sys "나는 그 지긋지긋한 '일반 중학교'의 교문을 밟았다."

    sys "내가 원해서 온 곳이 아니라는 비뚤어진 선민의식,\n'너희 따위와는 질적으로 다르다'는 유치한 오만함."
    sys "그 알량한 벽을 치고 앉아있던 내 책상 주변에는 당연하게도 친구 하나 다가오지 않았다."

    sys "하지만 공부만큼은 사립초 시절의 밑천 덕에 너무나 쉬웠고,\n세상은 거칠 것 없이 만만해 보였다."
    sys "그 지독한 적막과 오만을 깨고 불쑥 다가온 녀석이 바로 '천호'였다."

    show chunho normal at center with dissolve
    ch "야, 멍때리지 말고 매점 가자. 빵 산다."
    me "……귀찮게 진짜."
    hide chunho normal with dissolve
    $ renpy.pause(1.0)

    sys "눈치 같은 건 개나 줘버린 넉살과 선을 아슬아슬하게 넘나드는 천호 덕분에,\n나는 태어나 처음으로 교실 안에서 숨통이 트이는 기분을 맛보았다."
    
    # ==============================================================================
    # 2. PC방의 쾌락과 타락 (나쁜 무리와의 접촉)
    # ==============================================================================
    scene bg pc_bang with fade
    play music "audio/bgm_pcbang.ogg" fadein 1.0
    $ renpy.pause(1.0)

    sys "초등학교 때까지만 해도 우리 집은 숨이 막힐 만큼 엄격했다."
    sys "PC방이라는 곳은 금기의 영역이었고,\n컴퓨터 화면 속 세상은 남들의 이야기일 뿐이었다."

    sys "하지만 중학교에 올라와 고삐가 풀렸다."
    sys "어두컴컴한 공간, 화려한 모니터 빛, 귓가를 때리는 효과음과 라면 냄새.\n그 날것의 쾌락에 나는 순식간에 매료되었다."

    sys "학교가 끝나면 무조건 PC방으로 향했고,\n그곳에서 천호 외에도 소위 '놀던 녀석들'과 얽히기 시작했다."
    sys "그 무리 중 하나가 바로 '준호'였다."

    stop music fadeout 1.0

    # ==============================================================================
    # 3. 준호의 제안: 거절하지 못한 망보기
    # ==============================================================================
    scene bg bicycle with fade

    sys "해 질 무렵의 골목길."
    sys "준호가 상가 구석에 세워진 번쩍이는 자전거 한 대를 가리켰다.\n한눈에 봐도 족히 수십만 원은 넘어 보이는 고급 로드 바이크였다."

    jh "야, 저거 봐라. 잠금장치 완전 허술한데?"
    jh "내가 털 테니까, 넌 저기 골목 입구에서 망 좀 봐라."

    jh "아, 쫄기는. 금방 끝난다니까? 망만 보라고, 망만."
    jh "너 설마 여기서 뺄 거냐? 재미없게 왜 이래."

    # 1. menu: 선언
    menu:
        # 질문이나 상황 설명을 선택지 위에 띄우고 싶을 때 (선택 사항)
        "준호가 자전거 망을 보라고 재촉해온다."

        # 첫 번째 선택지
        "……딱 이번 한 번만이다. 빨리 털어.":
            me "……딱 이번 한 번만이다. 빨리 끝내."
            sys "결국 비겁함을 가오로 포장하며 골목 입구로 돌아섰다."

        # 두 번째 선택지
        "나 진짜 이런 거 해본 적 없는데……":
            me "야, 나 진짜 이런 거 한 번도 안 해봤단 말이야……."
            sys "손끝이 덜덜 떨렸다. 하지만 무리에서 튕겨 나갈 두려움이 더 컸다."

    # 선택지가 끝나면 둘 다 이 아래 코드로 자연스럽게 합쳐집니다.
    sys "결국 나는 차가운 골목 어귀에 서서 망을 보기 시작했다."

    sys "머릿속에서 사이렌이 요란하게 울렸다.\n단 한 번도 이런 짓을 해본 적도, 상상해본 적도 없었다."

    sys "하지만…… 초등학교 시절의 그 지독했던 고독이 떠올랐다."
    sys "'여기서 거절하면 무리에서 튕겨 나간다.'\n'다시 그 외톨이 시절로 돌아갈지도 모른다.'"

    sys "그 유치하고 비겁한 두려움이 내 입을 틀어막았다."

    me "……빨리 끝내."

    # ==============================================================================
    # 4. PC방에서의 전화, 그리고 검거
    # ==============================================================================
    scene bg pc_game with fade
    play music "audio/bgm_pcbang.ogg" fadein 1.0

    sys "훔친 자전거를 상가 뒤편에 대충 던져두고, 우리는 태연하게 PC방에 틀어박혔다."
    sys "헤드셋을 끼고 게임의 승패에 도파민을 터뜨리며,\n불과 30분 전의 죄책감 따위는 금세 잊혀가는 듯했다."

    # 전화 진동음
    play sound "audio/phone_ring.ogg"
    $ renpy.pause(1.0)
    scene bg police_call with dissolve

    sys "요란하게 울리는 휴대폰 화면.\n발신자는 알 수 없는 번호였다."
    stop sound fadeout 0.5
    stop music fadeout 1.0

    # stop sound
    me "여보세요?"

    cop "……김병연 학생 맞습니까?"

    me "네? 맞는데요. 누구세요?"

    cop "춘천경찰서 생활안전계 이 순경입니다."
    cop "지금 타고 다니는 자전거 본인 거 맞아요? 어디 있습니까?"

    play sound "audio/boom.ogg"
    camera:
        ease 0.6 zoom 1.3 xoffset -700 yoffset -250
    

    menu:
        "이 순경의 전화를 받았다. 뭐라고 답할까?"

        "어리버리 사실대로 말한다":
            $ bike_choice = "honest"
            me "아…… 그게 상가 앞에 있는데요……."
            sys "인생에서 처음 겪는 공포에 머리가 하얘져 자백해버렸다."

        "발뺌한다":
            $ bike_choice = "lie"
            me "무슨 소리세요? 저 그런 거 모르는데요."
            cop "CCTV 다 확인했고 너희 둘 찍힌 거 보고 전화한 거야."
            sys "하찮은 거짓말은 1초 만에 박살 났다."

    
    # 나중에 이 변수를 활용해 대사 한 줄을 다르게 칠 수 있음
    if bike_choice == "honest":
        sys "그나마 바로 털어놓았던 게 다행이었을까."
    else:
        sys "그 와중에 거짓말까지 쳤던 탓에 경찰의 목소리는 더 날카로워졌다."

    # --- 대사가 끝나고 원래 화면 크기로 복귀 ---
    camera:
        ease 0.5 zoom 1.0 xoffset 0 yoffset 0
    
    cop "거기 꼼짝 말고 그대로 계세요. 지금 바로 갑니다."
    sys "눈치라도 있었으면 둘러대거나 도망이라도 쳤을 텐데,\n인생에서 처음 겪어보는 상황에 완전히 사고가 정지해 버렸다."
   
    # ==============================================================================
    # 5. 경찰서 인계와 지장 날인
    # ==============================================================================
    scene bg police_station with fade
    
    sys "정신을 차렸을 땐 이미 파출소 의자에 앉아 있었다."
    cop "학생, 나이가 몇인데 남의 비싼 자전거에 손을 대?"
    cop "CCTV에 얼굴이랑 도주로까지 싹 다 찍혔어. 빼도 박도 못해."
    
    sys "차가운 형광등 불빛 아래, 무릎을 쥔 손이 주체할 수 없이 떨려왔다."
    sys "순간의 욕심이 불러온 대가는 너무나 가혹하고 거대했다."

    scene black with fade

    sys "다음 날 아침, 결국 아버지에게 연락이 닿았다."
    sys "평생 정직하게 일하며 살아오신 아버지의 얼굴 앞에서,\n나는 고개도 들지 못한 채 모든 것을 털어놓을 수밖에 없었다."

    sys "춘천경찰서로 인계된 뒤, 훔친 물건 확인서에 검은 인주를 묻혀 손도장을 찍었다."
    sys "차가운 종이 위에 찍힌 붉은 지장."
    sys "나는 그저 이 부끄러운 도장 하나 찍는 것으로,\n어린 날의 철없는 사고가 끝나는 줄로만 알았다."

    sys "하지만…… 그것은 진짜 지옥의 시작에 불과했다."

    # 5. 끝나지 않은 악몽: 자전거 주인의 고소와 법원 소환장
    # ==============================================================================
    play music "audio/bgm_sad.ogg" fadein 1.0
    scene bg room_night with fade
    
    # 전화벨 소리
    play sound "audio/phone_ring.ogg"
    $ renpy.pause(2.0)
    
    sys "불과 며칠 뒤, 다시 울린 경찰서의 전화."
    stop sound fadeout 0.5  # 전화벨 효과음 종료
    play sound "audio/phone_pickup.ogg"
    $ renpy.pause(1.0)
    cop "병연 학생, 나 이 순경인데. 통화 괜찮아요?"
    cop "하…… 다름이 아니고, 그 자전거 주인분 말이에요."
    cop "학생 나이도 어리고 초범이라 우리가 중간에서 선처 쪽으로 설득을 좀 해봤는데…… 주인이 완강하네. 화가 아주 많이 났어요."
    cop "방금 고소장 정식으로 접수됐고, 사건 소년부 송치 절차 들어갑니다. 아버님 옆에 계시면 전화 좀 바꿔줄래요?"

    sys "자전거의 원래 주인은 어린 학생이라고 봐줄 생각이 추호도 없었다."
    sys "합의는 결렬되었고, 정식 '고소'가 접수되었으니\n다음 주에 춘천경찰서 상급 지부로 출석하라는 싸늘한 통보였다."

    sys "아버지는 어떻게든 어린 자식의 등에 빨간 줄이 그어지는 것만은 막기 위해\n피해자를 찾아가 고개를 숙이고 백방으로 선처를 구하셨다."
    sys "하지만 그 눈물겨운 노력도 차가운 법의 시스템 앞에서는 역부족이었다."

    stop music fadeout 1.0

    # 우편물 날아드는 연출
    scene black with Dissolve(0.5)
    $ renpy.pause(1.0)

    play sound "audio/boom.ogg"
    scene bg court_summon with Dissolve(0.8)
    $ renpy.pause(0.5)
    sys "얼마 지나지 않아 집으로 날아든 하얀 우편 봉투 하나."
    sys "‘피고인 김병연.’\n춘천지방법원 소년재판정에 출석하라는 정식 법원 공문이었다."

    # ==============================================================================
    # 6. 춘천지방법원 소년재판정: 서슬 퍼런 일침
    # ==============================================================================
    scene bg outside_court with fade
    sys "2주 뒤, 춘천지방법원 소년재판소."
    sys "작년까지만 해도 엘리트로 살던 내가 이 곳을 오게 될 줄은 꿈에도 몰랐다"
    # play music "audio/court_ambient.ogg" fadein 2.0

    scene bg courtroom with fade
    sys "차가운 공기, 양측 소송대리인의 딱딱하고 메마른 변론이 오가는 동안\n나는 고개를 처박은 채 내 숨소리조차 제대로 내지 못했다."
    # 판사의 발언
    # play sound "audio/gavel_bang.ogg"
    judge "피고인!!!"
    with vpunch # 화면 흔들림 연출
    sys "높다란 판사석에서 내려다보는 차가운 시선이 정수리에 내리꽂혔다."

    judge "아무리 나이가 어린 학생이라도,{w=0.3} 남의 피땀 어린 재물에 손을 대는 것은\n절대로 용납될 수 없는 명백한 범죄입니다."
    judge "‘장난이었다’, ‘친구가 시켜서 그랬다’는 말로 책임을 피할 수 있다고 생각합니까?"

    sys "귀가 먹먹해질 정도로 서늘한 호통이었다.\n어린 날의 기억에 대못처럼 박힐 만큼 날카로운 일침이었다."

    judge "다만, 초범인 점과 아직 어린 나이라는 점을 참작하여\n소년원 송치는 유예합니다."
