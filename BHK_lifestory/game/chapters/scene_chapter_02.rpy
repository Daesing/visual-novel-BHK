    # play sound "audio/sfx_phone_vibration.ogg"
    $ renpy.pause(0.5)

    sys "그러던 어느 늦은 밤, 서진이에게서 연락이 왔다."
    sys "‘잠깐 볼 수 있어? 너희 집 앞으로 갈게.’"

    scene bg front_house_night with fade
    stop music fadeout 1.5
    window hide

    sys "가로등 불빛 아래 서서 기다린 지 얼마 지나지 않아,\n어둠을 가르고 택시 한 대가 집 앞 골목에 멈춰 섰다."

    # 차 문 닫히는 소리
    # play sound "audio/sfx_car_door.ogg"

    sys "조용히 문을 열고 내린 것은 서진이었다."

    show seojin cold at center with dissolve

    sys "가로등 불빛을 등진 서진이의 얼굴은 전에 없이 굳어 있었고,\n공기 중에는 묘한 긴장감이 감돌았다."

    sj "……병연아."
    me "어, 서진아. 이 시간에 여기까지 웬일이야?"

    sj "……나, 많이 생각해 봤는데."
    sj "나…… 너 정말 너무 좋아하거든? 진짜 진심이었어."
    sj "근데…… 내가 옆에서 널 너무 힘들게만 하는 것 같아."
    sj "우리…… 여기서 그만 헤어지는 게 맞는 것 같아."

    # ------------------------------------------------------------------------------
    # 씁쓸한 납득과 장난 섞인 마무리
    # ------------------------------------------------------------------------------
    sys "순간, 모자 속 까까머리에 손이 닿았다."
    sys "‘아…… 머리를 빡빡 밀어버린 내가 이제 매력이 떨어졌나 보구나.’"
    sys "씁쓸했지만, 한편으로는 가슴 한구석에서 묘한 해방감이 스쳐 지나갔다."

    sys "안 그래도 시험 전날 간호 사건부터 명품 소문까지,\n나를 갉아먹는 이 위태로운 관계를 끝내고 싶다는 생각을 수없이 해왔으니까."
    sys "‘그래, 차라리 잘됐다. 이걸 빌미로 여기서 끝내자.’"

    me "……그래. 네가 그렇게 생각한다면 어쩔 수 없지. 알겠어."

    hide seojin with dissolve
    sys "서진이는 미안한 표정을 지으며 다시 택시 문을 열었다."
    sys "돌아가는 차창 너머를 보며, 나는 마지막 자존심이라도 챙기듯 반쯤 농담을 툭 던졌다."

    me "야, 차서진! 우리 진짜 안 헤어지면 안 되냐? 다시 생각해 봐라~"

    sys "피식 웃으며 손을 흔들었고, 택시는 붉은 후미등을 깜빡이며 골목을 빠져나갔다."
    sys "그렇게…… 서로에게 큰 상처 없이 나름 깔끔하게 마무리된 줄 알았다."

    # ==============================================================================
    # 19. 2주 뒤의 폭탄: 환승연애의 실체
    # ==============================================================================
    scene bg highschool_hallway with fade
    play music "audio/bgm_suspense_drone.ogg" fadein 2.0
    window hide

    sys "이별 후 정확히 2주가 흘렀을 무렵."
    sys "교실 복도에서 내 귀를 의심케 하는 괴상한 소문이 돌기 시작했다."

    sys "‘야, 차서진 새 남친 생겼다던데?’\n‘헤어진 지 며칠이나 됐다고 벌써 딴 놈이랑 사귀냐?’"

    me "하…… 말도 안 되는 소리 하지 마라. 걔가 그럴 애는 아니야."

    sys "처음엔 헛소문이라 치부했다.\n헤어질 때 ‘너를 너무 좋아하지만 힘들게 해서 떠난다’며 눈시울을 붉히던 그 얼굴이 떠올랐기에."

    # ------------------------------------------------------------------------------
    # 팩트 확인: 끓어오르는 용암
    # ------------------------------------------------------------------------------
    # BGM 칼정지 (적막)
    stop music

    sys "하지만…… 그 의리는 단 며칠 만에 산산조각이 났다."
    sys "친구들이 보여준 증거, 겹치는 지인들의 입을 통해 확인된 진실은 너무나 명백했다."

    # 묵직한 서브 쿵 효과음
    # play sound "audio/sfx_sub_bass_drop.ogg"
    camera:
        ease 0.25 zoom 1.4 yoffset -50

    sys "{size=+6}환승연애.{/size}"
    sys "내가 머리를 밀고 스터디카페에서 썩어가는 동안,\n서진이는 이미 다른 놈과 다리를 걸쳐두고 있었던 것이었다."

    with vpunch
    $ renpy.pause(0.5)

    sys "‘내가 널 너무 힘들게 해서 헤어지는 거야?’"
    sys "그 가증스럽고 위선적인 주둥이로 뱉어낸 이별 통보는,\n그저 새 남자로 갈아타기 위한 추악한 명분에 불과했다."

    camera:
        ease 0.8 zoom 1.0 yoffset 0

    sys "살면서 남에게 큰 소리 한번 쳐본 적 없었고, 웬만하면 욕도 입에 담지 않는 나였다."
    sys "하지만 그 순간, 가슴 밑바닥에서부터 억누를 수 없는 용암 같은 분노가 치밀어 올랐다."
    sys "세상이 통째로 무너져 내리는 듯한 배신감과 모멸감에 온몸이 부들부들 떨렸다."

    # ==============================================================================
    # 20. 스터디카페의 포스트잇: MSG 0%의 분노와 각성
    # ==============================================================================
    scene bg study_cafe_desk_night with fade
    window hide

    sys "눈이 뒤집힌 채로 발걸음이 향한 곳은 언제나처럼 그 삭막한 스터디카페였다."
    sys "가방을 던지듯 내려놓고, 핏발 선 눈으로 책상 앞에 주저앉았다."

    # 필기구 거칠게 꺼내는 소리
    # play sound "audio/sfx_pen_scratch.ogg"

    sys "노란색 포스트잇 한 장을 거칠게 뜯어 책상 정중앙에 붙였다."
    sys "그리고 볼펜을 부러뜨릴 듯이 쥐고, 종이가 찢어지도록 한 글자 한 글자 눌러 담아 써 내려갔다."

    # ------------------------------------------------------------------------------
    # NVL 모드 전환: 피 끓는 독백과 원문 그대로의 포스트잇
    # ------------------------------------------------------------------------------
    nvl clear
    window hide
    scene black with fade
    # play music "audio/bgm_rage_awakening.ogg" fadein 2.0

    nvl_sys "지금 내가 할 수 있는 것은 아무것도 없다."
    nvl_sys "그저 내가 할 수 있는 유일한 복수는,\n좋은 대학에 가서 누구보다 성공한 삶을 사는 것뿐이다."

    # 가장 거칠고 날것의 문장: 붉은색 강조 및 화면 흔들림
    nvl_sys "{size=+8}{color=#c0392b}그리고 차서진 나쁜 씨발년.{/color}{/size}" with vpunch

    nvl clear

    # ------------------------------------------------------------------------------
    # 두 번째 통타, 그리고 괴물의 탄생
    # ------------------------------------------------------------------------------
    scene bg study_cafe_desk_night with fade
    window hide

    sys "책상 위에 붙은 그 저주의 문장을 쏘아보며 거친 숨을 몰아쉬었다."
    sys "머리끝부터 발끝까지 주체할 수 없는 살의와 분노가 혈관을 타고 질주했다."

    # 카메라 서서히 줌인 (눈빛 집중)
    camera:
        ease 1.5 zoom 1.25 yoffset -40

    sys "중학교 시절, 소년재판정의 차가운 바닥에서 첫 번째 둔기로 대가리를 얻어맞았다면——"
    sys "이날 스터디카페에서 확인한 진실은 내 영혼을 후려친 두 번째 해머였다."

    sys "착하게 살면 호구가 되고, 양보하면 뒤통수를 맞는다."
    sys "그 잔인한 현실의 법칙을 온몸으로 깨달은 순간,\n내 안에서 미련과 순진함 따위의 찌꺼기는 흔적도 없이 타버렸다."

    sys "‘반드시 성공한다.’\n‘네년이 평생 우러러보지도 못할 자리까지 기어 올라가서, 똑똑히 비웃어주마.’"

    camera:
        ease 0.8 zoom 1.0 yoffset 0

    sys "복수심으로 가득 찬 괴물이,\n그 어두운 스터디카페 칸막이 안에서 눈을 뜨고 있었다."

